digraph dependencies {
    rankdir=TB;
    node [shape=box, style="rounded,filled", fillcolor="#e8f0fe", fontname="sans-serif"];
    edge [fontname="sans-serif", fontsize=10];
    "rand" [fillcolor="#a8d5e5", style="rounded,filled,bold"];
    "libc";
    "ppv-lite86";
    "rand_chacha";
    "rand_core";
    "rand" -> "libc";
    "rand" -> "rand_chacha";
    "rand" -> "rand_core";
    "rand_chacha" -> "ppv-lite86";
    "rand_chacha" -> "rand_core";
}